<form class="hkrpg-sheet flexcol" autocomplete="off">
  <header class="hkrpg-sheet-header">
    <img class="hkrpg-portrait" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />

    <div class="hkrpg-header-main">
      <label class="hkrpg-name-field">
        <span>{{localize "HKRPG.Profile.Name"}}</span>
        <input name="name" type="text" value="{{actor.name}}" placeholder="Имя жука" />
      </label>

      <div class="hkrpg-header-fields">
        <label>
          <span>{{localize "HKRPG.Size.Label"}}</span>
          <select name="system.size">
            {{#select system.size}}
              <option value="small">{{localize "HKRPG.Size.Small"}}</option>
              <option value="medium">{{localize "HKRPG.Size.Medium"}}</option>
              <option value="large">{{localize "HKRPG.Size.Large"}}</option>
            {{/select}}
          </select>
        </label>
        <label>
          <span>{{localize "HKRPG.Profile.Milestone"}}</span>
          <input name="system.profile.milestone" type="number" min="0" value="{{system.profile.milestone}}" />
        </label>
        <label>
          <span>{{localize "HKRPG.Profile.MinorAdvancements"}}</span>
          <input name="system.profile.minorAdvancements" type="number" min="0" value="{{system.profile.minorAdvancements}}" />
        </label>
      </div>

      <div class="hkrpg-header-resources">
        <div class="hkrpg-header-resource hkrpg-header-resource--heart">
          <svg class="hkrpg-header-resource__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 21.2 10.4 19.8C4.7 14.7 1 11.3 1 7.2 1 3.9 3.6 1.4 6.9 1.4c2 0 3.9.9 5.1 2.5 1.2-1.6 3.1-2.5 5.1-2.5C20.4 1.4 23 3.9 23 7.2c0 4.1-3.7 7.5-9.4 12.6L12 21.2Z"/></svg>
          <span class="hkrpg-header-resource__name">{{localize "HKRPG.Resource.Heart"}}</span>
          <strong class="hkrpg-header-resource__value">{{system.resources.heart}} / {{system.resources.heartMax}}</strong>
          <div class="hkrpg-resource-pips">
            <div class="hkrpg-resource-pips__base">
              {{#each resourcePips.heart.base as |pip|}}
                <button type="button" class="hkrpg-pip hkrpg-pip--heart {{#if pip.filled}}is-filled{{else}}is-empty{{/if}}" data-resource-pip="heart" data-resource-target="{{pip.clickValue}}" title="{{pip.value}}" aria-label="{{localize "HKRPG.Resource.Heart"}} {{pip.value}}" {{#unless isEditable}}disabled{{/unless}}><svg class="hkrpg-pip__svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 21.2 10.4 19.8C4.7 14.7 1 11.3 1 7.2 1 3.9 3.6 1.4 6.9 1.4c2 0 3.9.9 5.1 2.5 1.2-1.6 3.1-2.5 5.1-2.5C20.4 1.4 23 3.9 23 7.2c0 4.1-3.7 7.5-9.4 12.6L12 21.2Z"/></svg></button>
              {{/each}}
              {{#if resourcePips.heart.baseOverflow}}<span class="hkrpg-pip-overflow">+{{resourcePips.heart.baseOverflow}}</span>{{/if}}
            </div>
            <div class="hkrpg-resource-pips__temporary">
              {{#each resourcePips.heart.temporary as |pip|}}
                <button type="button" class="hkrpg-pip hkrpg-pip--heart hkrpg-pip--temporary" data-resource-pip="heartTemp" data-resource-target="{{pip.clickValue}}" title="{{localize "HKRPG.Tracker.SpendTemporary"}}" aria-label="{{localize "HKRPG.Tracker.SpendTemporary"}}" {{#unless isEditable}}disabled{{/unless}}><svg class="hkrpg-pip__svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 21.2 10.4 19.8C4.7 14.7 1 11.3 1 7.2 1 3.9 3.6 1.4 6.9 1.4c2 0 3.9.9 5.1 2.5 1.2-1.6 3.1-2.5 5.1-2.5C20.4 1.4 23 3.9 23 7.2c0 4.1-3.7 7.5-9.4 12.6L12 21.2Z"/></svg></button>
              {{/each}}
              {{#if resourcePips.heart.temporaryOverflow}}<span class="hkrpg-pip-overflow hkrpg-pip-overflow--temporary">+{{resourcePips.heart.temporaryOverflow}}</span>{{/if}}
            </div>
          </div>
          <div class="hkrpg-header-resource__fields">
            <label><span>{{localize "HKRPG.Tracker.Maximum"}}</span><input data-resource-field="heartMax" type="number" min="0" value="{{system.resources.heartMax}}" {{#unless isEditable}}disabled{{/unless}} /></label>
            <label><span>{{localize "HKRPG.Tracker.Temporary"}}</span><input data-resource-field="heartTemp" type="number" min="0" value="{{system.resources.heartTemp}}" {{#unless isEditable}}disabled{{/unless}} /></label>
          </div>
        </div>

        <div class="hkrpg-header-resource hkrpg-header-resource--soul">
          <span class="hkrpg-header-resource__icon hkrpg-header-resource__icon--soul" aria-hidden="true"></span>
          <span class="hkrpg-header-resource__name">{{localize "HKRPG.Resource.Soul"}}</span>
          <strong class="hkrpg-header-resource__value">{{system.resources.soul}} / {{system.resources.soulMax}}</strong>
          <div class="hkrpg-resource-pips">
            <div class="hkrpg-resource-pips__base">
              {{#each resourcePips.soul.base as |pip|}}
                <button type="button" class="hkrpg-pip hkrpg-pip--soul {{#if pip.filled}}is-filled{{else}}is-empty{{/if}}" data-resource-pip="soul" data-resource-target="{{pip.clickValue}}" title="{{pip.value}}" aria-label="{{localize "HKRPG.Resource.Soul"}} {{pip.value}}" {{#unless isEditable}}disabled{{/unless}}><span class="hkrpg-pip__shape"></span></button>
              {{/each}}
              {{#if resourcePips.soul.baseOverflow}}<span class="hkrpg-pip-overflow">+{{resourcePips.soul.baseOverflow}}</span>{{/if}}
            </div>
            <div class="hkrpg-resource-pips__temporary">
              {{#each resourcePips.soul.temporary as |pip|}}
                <button type="button" class="hkrpg-pip hkrpg-pip--soul hkrpg-pip--temporary" data-resource-pip="soulTemp" data-resource-target="{{pip.clickValue}}" title="{{localize "HKRPG.Tracker.SpendTemporary"}}" aria-label="{{localize "HKRPG.Tracker.SpendTemporary"}}" {{#unless isEditable}}disabled{{/unless}}><span class="hkrpg-pip__shape"></span></button>
              {{/each}}
              {{#if resourcePips.soul.temporaryOverflow}}<span class="hkrpg-pip-overflow hkrpg-pip-overflow--temporary">+{{resourcePips.soul.temporaryOverflow}}</span>{{/if}}
            </div>
          </div>
          <div class="hkrpg-header-resource__fields">
            <label><span>{{localize "HKRPG.Tracker.Maximum"}}</span><input data-resource-field="soulMax" type="number" min="0" value="{{system.resources.soulMax}}" {{#unless isEditable}}disabled{{/unless}} /></label>
            <label><span>{{localize "HKRPG.Tracker.Temporary"}}</span><input data-resource-field="soulTemp" type="number" min="0" value="{{system.resources.soulTemp}}" {{#unless isEditable}}disabled{{/unless}} /></label>
          </div>
        </div>

        <div class="hkrpg-header-resource hkrpg-header-resource--stamina">
          <svg class="hkrpg-header-resource__icon hkrpg-header-resource__icon--stamina" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 1 15.2 8.8 23 12l-7.8 3.2L12 23l-3.2-7.8L1 12l7.8-3.2L12 1Z"/></svg>
          <span class="hkrpg-header-resource__name">{{localize "HKRPG.Resource.Stamina"}}</span>
          <strong class="hkrpg-header-resource__value">{{system.resources.stamina}} / {{system.resources.staminaMax}}</strong>
          <div class="hkrpg-resource-pips">
            <div class="hkrpg-resource-pips__base">
              {{#each resourcePips.stamina.base as |pip|}}
                <button type="button" class="hkrpg-pip hkrpg-pip--stamina {{#if pip.filled}}is-filled{{else}}is-empty{{/if}}" data-resource-pip="stamina" data-resource-target="{{pip.clickValue}}" title="{{pip.value}}" aria-label="{{localize "HKRPG.Resource.Stamina"}} {{pip.value}}" {{#unless isEditable}}disabled{{/unless}}><span class="hkrpg-pip__shape"></span></button>
              {{/each}}
              {{#if resourcePips.stamina.baseOverflow}}<span class="hkrpg-pip-overflow">+{{resourcePips.stamina.baseOverflow}}</span>{{/if}}
            </div>
            <div class="hkrpg-resource-pips__temporary">
              {{#each resourcePips.stamina.temporary as |pip|}}
                <button type="button" class="hkrpg-pip hkrpg-pip--stamina hkrpg-pip--temporary" data-resource-pip="staminaTemp" data-resource-target="{{pip.clickValue}}" title="{{localize "HKRPG.Tracker.SpendTemporary"}}" aria-label="{{localize "HKRPG.Tracker.SpendTemporary"}}" {{#unless isEditable}}disabled{{/unless}}><span class="hkrpg-pip__shape"></span></button>
              {{/each}}
              {{#if resourcePips.stamina.temporaryOverflow}}<span class="hkrpg-pip-overflow hkrpg-pip-overflow--temporary">+{{resourcePips.stamina.temporaryOverflow}}</span>{{/if}}
            </div>
          </div>
          <div class="hkrpg-header-resource__fields">
            <label><span>{{localize "HKRPG.Tracker.Maximum"}}</span><input data-resource-field="staminaMax" type="number" min="0" value="{{system.resources.staminaMax}}" {{#unless isEditable}}disabled{{/unless}} /></label>
            <label><span>{{localize "HKRPG.Tracker.Temporary"}}</span><input data-resource-field="staminaTemp" type="number" min="0" value="{{system.resources.staminaTemp}}" {{#unless isEditable}}disabled{{/unless}} /></label>
          </div>
        </div>
      </div>
    <section class="hkrpg-satiety-summary">
      <h2>{{localize "HKRPG.Resource.Satiety"}}</h2>
      <div class="hkrpg-satiety-values">
        <label>
          <span>{{localize "HKRPG.Tracker.Current"}}</span>
          <input name="system.resources.satiety" type="number" min="0" value="{{system.resources.satiety}}" />
        </label>
        <div class="hkrpg-satiety-maximum">
          <span>{{localize "HKRPG.Tracker.Maximum"}}</span>
          <div class="hkrpg-satiety-maximum__control">
            <input data-derived-input="satietyMax" type="number" min="0" max="999" step="1" value="{{system.derived.satietyMax}}" {{#unless isEditable}}disabled{{/unless}} />
            <button type="button" class="hkrpg-derived-stat__reset" data-reset-derived="satietyMax" title="{{localize "HKRPG.Derived.ResetAutomatic"}}" aria-label="{{localize "HKRPG.Derived.ResetAutomatic"}}" {{#unless isEditable}}disabled{{/unless}}>↺</button>
          </div>
        </div>
      </div>
      <label class="hkrpg-hunger-field">
        <span>{{localize "HKRPG.Resource.Hunger"}}</span>
        <input name="system.resources.hunger" type="number" min="0" value="{{system.resources.hunger}}" />
      </label>
    </section>
  </header>

  <nav class="hkrpg-tabs" data-group="primary" aria-label="Разделы персонажа">
    <a class="item" data-tab="overview">{{localize "HKRPG.Tabs.Overview"}}</a>
    <a class="item" data-tab="features">{{localize "HKRPG.Tabs.Features"}}</a>
    <a class="item" data-tab="charms">{{localize "HKRPG.Tabs.Charms"}}</a>
    <a class="item" data-tab="equipment">{{localize "HKRPG.Tabs.Equipment"}}</a>
    <a class="item" data-tab="effects">{{localize "HKRPG.Tabs.Effects"}}</a>
    <a class="item" data-tab="journal">{{localize "HKRPG.Tabs.Journal"}}</a>
  </nav>

  <div class="hkrpg-tab-content">
    <section class="tab" data-group="primary" data-tab="overview">
      <div class="hkrpg-overview-grid">
        <div class="hkrpg-overview-main">
          <section class="hkrpg-overview-section">
            <h2>{{localize "HKRPG.Attributes"}}</h2>
            <div class="hkrpg-attributes-grid">
              <div class="hkrpg-attribute">
                <label class="hkrpg-attribute-score">
                  <span>{{localize "HKRPG.Attribute.Might"}}</span>
                  <input name="system.attributes.might" type="number" min="0" max="7" step="0.5" value="{{system.attributes.might}}" />
                </label>
                <label class="hkrpg-attribute-temporary">
                  <span>{{localize "HKRPG.Tracker.Temporary"}}</span>
                  <input name="system.attributeTemps.might" type="number" min="0" step="1" value="{{system.attributeTemps.might}}" />
                </label>
                <button type="button" data-attribute-roll="might" class="hkrpg-attribute-roll" title="{{localize "HKRPG.Roll.ClickToRoll"}}" aria-label="{{localize "HKRPG.Roll.ClickToRoll"}}">🎲</button>
              </div>

              <div class="hkrpg-attribute">
                <label class="hkrpg-attribute-score">
                  <span>{{localize "HKRPG.Attribute.Insight"}}</span>
                  <input name="system.attributes.insight" type="number" min="0" max="7" step="0.5" value="{{system.attributes.insight}}" />
                </label>
                <label class="hkrpg-attribute-temporary">
                  <span>{{localize "HKRPG.Tracker.Temporary"}}</span>
                  <input name="system.attributeTemps.insight" type="number" min="0" step="1" value="{{system.attributeTemps.insight}}" />
                </label>
                <button type="button" data-attribute-roll="insight" class="hkrpg-attribute-roll" title="{{localize "HKRPG.Roll.ClickToRoll"}}" aria-label="{{localize "HKRPG.Roll.ClickToRoll"}}">🎲</button>
              </div>

              <div class="hkrpg-attribute">
                <label class="hkrpg-attribute-score">
                  <span>{{localize "HKRPG.Attribute.Shell"}}</span>
                  <input name="system.attributes.shell" type="number" min="0" max="7" step="0.5" value="{{system.attributes.shell}}" />
                </label>
                <label class="hkrpg-attribute-temporary">
                  <span>{{localize "HKRPG.Tracker.Temporary"}}</span>
                  <input name="system.attributeTemps.shell" type="number" min="0" step="1" value="{{system.attributeTemps.shell}}" />
                </label>
                <button type="button" data-attribute-roll="shell" class="hkrpg-attribute-roll" title="{{localize "HKRPG.Roll.ClickToRoll"}}" aria-label="{{localize "HKRPG.Roll.ClickToRoll"}}">🎲</button>
              </div>

              <div class="hkrpg-attribute">
                <label class="hkrpg-attribute-score">
                  <span>{{localize "HKRPG.Attribute.Grace"}}</span>
                  <input name="system.attributes.grace" type="number" min="0" max="7" step="0.5" value="{{system.attributes.grace}}" />
                </label>
                <label class="hkrpg-attribute-temporary">
                  <span>{{localize "HKRPG.Tracker.Temporary"}}</span>
                  <input name="system.attributeTemps.grace" type="number" min="0" step="1" value="{{system.attributeTemps.grace}}" />
                </label>
                <button type="button" data-attribute-roll="grace" class="hkrpg-attribute-roll" title="{{localize "HKRPG.Roll.ClickToRoll"}}" aria-label="{{localize "HKRPG.Roll.ClickToRoll"}}">🎲</button>
              </div>
            </div>
          </section>

          <section class="hkrpg-overview-section">
            <h2>{{localize "HKRPG.OtherAttributes"}}</h2>
            <div class="hkrpg-secondary-grid">
              <div class="hkrpg-secondary-stat hkrpg-secondary-stat--rollable">
                <label>
                  <span>{{localize "HKRPG.Secondary.Spook"}}</span>
                  <input name="system.social.spook" type="number" min="0" step="0.5" value="{{system.social.spook}}" />
                </label>
                <button type="button" data-attribute-roll="spook" class="hkrpg-attribute-roll" title="{{localize "HKRPG.Roll.ClickToRoll"}}" aria-label="{{localize "HKRPG.Roll.ClickToRoll"}}">🎲</button>
              </div>
              <div class="hkrpg-secondary-stat hkrpg-secondary-stat--rollable">
                <label>
                  <span>{{localize "HKRPG.Secondary.Cute"}}</span>
                  <input name="system.social.cute" type="number" min="0" step="0.5" value="{{system.social.cute}}" />
                </label>
                <button type="button" data-attribute-roll="cute" class="hkrpg-attribute-roll" title="{{localize "HKRPG.Roll.ClickToRoll"}}" aria-label="{{localize "HKRPG.Roll.ClickToRoll"}}">🎲</button>
              </div>
            </div>
          </section>

          <section class="hkrpg-overview-section hkrpg-custom-reserves-section">
            <h2>{{localize "HKRPG.CustomReserves"}}</h2>
            <div class="hkrpg-custom-reserves">
              {{#each system.customReserves as |reserve key|}}
                <div class="hkrpg-custom-reserve">
                  <label class="hkrpg-custom-reserve__name">
                    <input name="system.customReserves.{{key}}.label" type="text" value="{{reserve.label}}" placeholder="{{localize "HKRPG.CustomReserve"}}" aria-label="{{localize "HKRPG.CustomReserve"}}" />
                  </label>
                  <div class="hkrpg-custom-reserve__fields">
                    <label>
                      <span>{{localize "HKRPG.Tracker.Maximum"}}</span>
                      <input name="system.customReserves.{{key}}.max" type="number" min="0" value="{{reserve.max}}" />
                    </label>
                    <label class="hkrpg-custom-reserve__current">
                      <span>{{localize "HKRPG.Tracker.Current"}}</span>
                      <input name="system.customReserves.{{key}}.current" type="number" min="0" value="{{reserve.current}}" />
                    </label>
                    <label>
                      <span>{{localize "HKRPG.Tracker.Temporary"}}</span>
                      <input name="system.customReserves.{{key}}.temporary" type="number" min="0" value="{{reserve.temporary}}" />
                    </label>
                  </div>
                </div>
              {{/each}}
            </div>
          </section>
        </div>

        <aside class="hkrpg-overview-side">
          <section class="hkrpg-overview-section hkrpg-skills-column">
            <h2>{{localize "HKRPG.Development.Proficiencies"}}</h2>
            {{#if itemGroups.proficiencies.length}}
              <ul class="hkrpg-item-list hkrpg-skill-list">
                {{#each itemGroups.proficiencies as |item|}}
                  <li class="hkrpg-skill-row"><span>{{item.name}}</span></li>
                {{/each}}
              </ul>
            {{else}}
              <p class="hkrpg-empty">{{localize "HKRPG.Empty.NoProficiencies"}}</p>
            {{/if}}
          </section>

          <section class="hkrpg-overview-section">
            <h2>{{localize "HKRPG.Movement"}}</h2>
            <div class="hkrpg-movement-stats">
              <label class="hkrpg-secondary-stat">
                <span>{{localize "HKRPG.Secondary.Speed"}}</span>
                <input name="system.social.speed" type="number" min="0" value="{{system.social.speed}}" />
              </label>
              <div class="hkrpg-secondary-stat hkrpg-derived-stat">
                <div class="hkrpg-derived-stat__heading">
                  <span>{{localize "HKRPG.Derived.Maneuverability"}}</span>
                  <button type="button" class="hkrpg-derived-stat__reset" data-reset-derived="maneuverability" title="{{localize "HKRPG.Derived.ResetAutomatic"}}" aria-label="{{localize "HKRPG.Derived.ResetAutomatic"}}" {{#unless isEditable}}disabled{{/unless}}>↺</button>
                </div>
                <input class="hkrpg-derived-stat__input" data-derived-input="maneuverability" type="number" min="0" max="999" step="1" value="{{system.derived.maneuverability}}" {{#unless isEditable}}disabled{{/unless}} />
              </div>
            </div>
          </section>
        </aside>
      </div>



    </section>

        <section class="tab" data-group="primary" data-tab="features">
      <div class="hkrpg-section-grid">
        <section class="hkrpg-panel">
          <div class="hkrpg-panel-heading"><h2>{{localize "HKRPG.Development.Traits"}}</h2><span>{{itemGroups.traits.length}}</span></div>
          {{#if itemGroups.traits.length}}
            <ul class="hkrpg-item-list">{{#each itemGroups.traits as |item|}}<li>{{item.name}}</li>{{/each}}</ul>
          {{else}}
            <p class="hkrpg-empty">{{localize "HKRPG.Empty.NoTraits"}}</p>
          {{/if}}
        </section>
        <section class="hkrpg-panel">
          <div class="hkrpg-panel-heading"><h2>{{localize "HKRPG.Development.Paths"}}</h2><span>{{itemGroups.paths.length}}</span></div>
          {{#if itemGroups.paths.length}}
            <ul class="hkrpg-item-list">{{#each itemGroups.paths as |item|}}<li>{{item.name}}</li>{{/each}}</ul>
          {{else}}
            <p class="hkrpg-empty">{{localize "HKRPG.Empty.NoPaths"}}</p>
          {{/if}}
        </section>

        <section class="hkrpg-panel">
          <div class="hkrpg-panel-heading"><h2>{{localize "HKRPG.Development.Techniques"}}</h2><span>{{itemGroups.techniques.length}}</span></div>
          <div class="hkrpg-derived-strip"><div><span>{{localize "HKRPG.Derived.TechniqueSlots"}}</span><strong>{{system.derived.techniqueSlots}}</strong></div></div>
          {{#if itemGroups.techniques.length}}
            <ul class="hkrpg-item-list">{{#each itemGroups.techniques as |item|}}<li>{{item.name}}</li>{{/each}}</ul>
          {{else}}
            <p class="hkrpg-empty">{{localize "HKRPG.Empty.NoTechniques"}}</p>
          {{/if}}
        </section>
      </div>
    </section>

    <section class="tab" data-group="primary" data-tab="charms">
      <div class="hkrpg-section-grid hkrpg-charms-grid">
        <section class="hkrpg-panel hkrpg-charms-panel">
          <div class="hkrpg-panel-heading"><h2>{{localize "HKRPG.Development.Charms"}}</h2><span>{{itemGroups.charms.length}}</span></div>
          {{#if itemGroups.charms.length}}
            <ul class="hkrpg-item-list">{{#each itemGroups.charms as |item|}}<li>{{item.name}}</li>{{/each}}</ul>
          {{else}}
            <p class="hkrpg-empty">{{localize "HKRPG.Empty.NoCharms"}}</p>
          {{/if}}
          <div class="hkrpg-derived-strip"><div><span>{{localize "HKRPG.Derived.BeltSize"}}</span><strong>{{system.derived.beltSize}}</strong></div></div>
        </section>
      </div>
    </section>

<section class="tab" data-group="primary" data-tab="equipment">
      <div class="hkrpg-section-grid">
        <section class="hkrpg-panel">
          <div class="hkrpg-panel-heading"><h2>{{localize "HKRPG.Equipment.Inventory"}}</h2><span>{{itemGroups.equipment.length}}</span></div>
          {{#if itemGroups.equipment.length}}
            <ul class="hkrpg-item-list">{{#each itemGroups.equipment as |item|}}<li>{{item.name}}</li>{{/each}}</ul>
          {{else}}
            <p class="hkrpg-empty">{{localize "HKRPG.Empty.NoEquipment"}}</p>
          {{/if}}
        </section>
        <section class="hkrpg-panel">
          <div class="hkrpg-panel-heading"><h2>{{localize "HKRPG.Equipment.Weapons"}}</h2><span>{{itemGroups.weapons.length}}</span></div>
          {{#if itemGroups.weapons.length}}
            <ul class="hkrpg-item-list">{{#each itemGroups.weapons as |item|}}<li>{{item.name}}</li>{{/each}}</ul>
          {{else}}
            <p class="hkrpg-empty">{{localize "HKRPG.Empty.NoWeapons"}}</p>
          {{/if}}
        </section>
        <section class="hkrpg-panel">
          <div class="hkrpg-panel-heading"><h2>{{localize "HKRPG.Equipment.Shields"}}</h2><span>{{itemGroups.shields.length}}</span></div>
          {{#if itemGroups.shields.length}}
            <ul class="hkrpg-item-list">{{#each itemGroups.shields as |item|}}<li>{{item.name}}</li>{{/each}}</ul>
          {{else}}
            <p class="hkrpg-empty">{{localize "HKRPG.Empty.NoShields"}}</p>
          {{/if}}
        </section>
        <section class="hkrpg-panel">
          <div class="hkrpg-panel-heading"><h2>{{localize "HKRPG.Equipment.Armor"}}</h2><span>{{itemGroups.armor.length}}</span></div>
          {{#if itemGroups.armor.length}}
            <ul class="hkrpg-item-list">{{#each itemGroups.armor as |item|}}<li>{{item.name}}</li>{{/each}}</ul>
          {{else}}
            <p class="hkrpg-empty">{{localize "HKRPG.Empty.NoArmor"}}</p>
          {{/if}}
        </section>
      </div>
      <section class="hkrpg-panel hkrpg-equipment-footer">
        <label><span>{{localize "HKRPG.Equipment.Currency"}}</span><input name="system.inventory.currency" type="number" min="0" value="{{system.inventory.currency}}" /></label>
        <div class="hkrpg-derived-strip"><div><span>{{localize "HKRPG.Derived.CarryingCapacity"}}</span><strong>{{system.derived.carryingCapacity}}</strong></div><div><span>{{localize "HKRPG.Derived.BeltSize"}}</span><strong>{{system.derived.beltSize}}</strong></div></div>
        <p class="hkrpg-empty">{{localize "HKRPG.Empty.WeightLater"}}</p>
      </section>
    </section>

    <section class="tab" data-group="primary" data-tab="effects">
      <div class="hkrpg-section-grid hkrpg-effects-grid">
        <section class="hkrpg-panel hkrpg-effects-panel">
          <div class="hkrpg-panel-heading"><h2>{{localize "HKRPG.Development.Marks"}}</h2></div>
          <p class="hkrpg-empty">{{localize "HKRPG.Empty.MarksLater"}}</p>
        </section>
      </div>
    </section>

<section class="tab" data-group="primary" data-tab="journal">
      <div class="hkrpg-notes-layout">
        <section class="hkrpg-panel">
          <h2>{{localize "HKRPG.Profile.Description"}}</h2>
          <textarea name="system.profile.description" rows="8">{{system.profile.description}}</textarea>
        </section>
        <section class="hkrpg-panel hkrpg-notes-panel">
          <h2>{{localize "HKRPG.Notes"}}</h2>
          <textarea name="system.notes" rows="16" placeholder="{{localize "HKRPG.NotesPlaceholder"}}">{{system.notes}}</textarea>
        </section>
      </div>
    </section>
  </div>
</form>