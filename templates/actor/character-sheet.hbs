<form class="hkrpg-sheet flexcol" autocomplete="off">
  <header class="hkrpg-sheet-header">
    <img class="hkrpg-portrait" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />

    <div class="hkrpg-header-main">
      <label class="hkrpg-name-field">
        <span>{{localize "HKRPG.Profile.Name"}}</span>
        <input name="name" type="text" value="{{actor.name}}" placeholder="Имя жука" />
      </label>

      <div class="hkrpg-header-fields">
        <label>
          <span>{{localize "HKRPG.Size.Label"}}</span>
          <select name="system.size">
            {{#select system.size}}
              <option value="small">{{localize "HKRPG.Size.Small"}}</option>
              <option value="medium">{{localize "HKRPG.Size.Medium"}}</option>
              <option value="large">{{localize "HKRPG.Size.Large"}}</option>
            {{/select}}
          </select>
        </label>
        <label>
          <span>{{localize "HKRPG.Profile.Milestone"}}</span>
          <input name="system.profile.milestone" type="number" min="0" value="{{system.profile.milestone}}" />
        </label>
        <label>
          <span>{{localize "HKRPG.Profile.MinorAdvancements"}}</span>
          <input name="system.profile.minorAdvancements" type="number" min="0" value="{{system.profile.minorAdvancements}}" />
        </label>
      </div>

      <div class="hkrpg-header-resources">
        <div class="hkrpg-header-resource hkrpg-header-resource--heart">
          <svg class="hkrpg-header-resource__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 21.2 10.4 19.8C4.7 14.7 1 11.3 1 7.2 1 3.9 3.6 1.4 6.9 1.4c2 0 3.9.9 5.1 2.5 1.2-1.6 3.1-2.5 5.1-2.5C20.4 1.4 23 3.9 23 7.2c0 4.1-3.7 7.5-9.4 12.6L12 21.2Z"/></svg>
          <span class="hkrpg-header-resource__name">{{localize "HKRPG.Resource.Heart"}}</span>
          <strong class="hkrpg-header-resource__value">{{system.resources.heart}} / {{system.resources.heartMax}}</strong>
          <div class="hkrpg-resource-pips">
            <div class="hkrpg-resource-pips__base">
              {{#each resourcePips.heart.base as |pip|}}
                <button type="button" class="hkrpg-pip hkrpg-pip--heart {{#if pip.filled}}is-filled{{else}}is-empty{{/if}}" data-resource-pip="heart" data-resource-target="{{pip.clickValue}}" title="{{pip.value}}" aria-label="{{localize "HKRPG.Resource.Heart"}} {{pip.value}}" {{#unless isEditable}}disabled{{/unless}}><svg class="hkrpg-pip__svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 21.2 10.4 19.8C4.7 14.7 1 11.3 1 7.2 1 3.9 3.6 1.4 6.9 1.4c2 0 3.9.9 5.1 2.5 1.2-1.6 3.1-2.5 5.1-2.5C20.4 1.4 23 3.9 23 7.2c0 4.1-3.7 7.5-9.4 12.6L12 21.2Z"/></svg></button>
              {{/each}}
              {{#if resourcePips.heart.baseOverflow}}<span class="hkrpg-pip-overflow">+{{resourcePips.heart.baseOverflow}}</span>{{/if}}
            </div>
            <div class="hkrpg-resource-pips__temporary">
              {{#each resourcePips.heart.temporary as |pip|}}
                <button type="button" class="hkrpg-pip hkrpg-pip--heart hkrpg-pip--temporary" data-resource-pip="heartTemp" data-resource-target="{{pip.clickValue}}" title="{{localize "HKRPG.Tracker.SpendTemporary"}}" aria-label="{{localize "HKRPG.Tracker.SpendTemporary"}}" {{#unless isEditable}}disabled{{/unless}}><svg class="hkrpg-pip__svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 21.2 10.4 19.8C4.7 14.7 1 11.3 1 7.2 1 3.9 3.6 1.4 6.9 1.4c2 0 3.9.9 5.1 2.5 1.2-1.6 3.1-2.5 5.1-2.5C20.4 1.4 23 3.9 23 7.2c0 4.1-3.7 7.5-9.4 12.6L12 21.2Z"/></svg></button>
              {{/each}}
              {{#if resourcePips.heart.temporaryOverflow}}<span class="hkrpg-pip-overflow hkrpg-pip-overflow--temporary">+{{resourcePips.heart.temporaryOverflow}}</span>{{/if}}
            </div>
          </div>
          <div class="hkrpg-header-resource__fields">
            <label><span>{{localize "HKRPG.Tracker.Current"}}</span><input data-resource-field="heart" type="number" min="0" max="999" value="{{system.resources.heart}}" {{#unless isEditable}}disabled{{/unless}} /></label>
            <label><span>{{localize "HKRPG.Tracker.Maximum"}}</span><input data-resource-field="heartMax" type="number" min="0" value="{{system.resources.heartMax}}" {{#unless isEditable}}disabled{{/unless}} /></label>
            <label><span>{{localize "HKRPG.Tracker.Temporary"}}</span><input data-resource-field="heartTemp" type="number" min="0" value="{{system.resources.heartTemp}}" {{#unless isEditable}}disabled{{/unless}} /></label>
          </div>
        </div>

        <div class="hkrpg-header-resource hkrpg-header-resource--soul">
          <span class="hkrpg-header-resource__icon hkrpg-header-resource__icon--soul" aria-hidden="true"></span>
          <span class="hkrpg-header-resource__name">{{localize "HKRPG.Resource.Soul"}}</span>
          <strong class="hkrpg-header-resource__value">{{system.resources.soul}} / {{system.resources.soulMax}}</strong>
          <div class="hkrpg-resource-pips">
            <div class="hkrpg-resource-pips__base">
              {{#each resourcePips.soul.base as |pip|}}
                <button type="button" class="hkrpg-pip hkrpg-pip--soul {{#if pip.filled}}is-filled{{else}}is-empty{{/if}}" data-resource-pip="soul" data-resource-target="{{pip.clickValue}}" title="{{pip.value}}" aria-label="{{localize "HKRPG.Resource.Soul"}} {{pip.value}}" {{#unless isEditable}}disabled{{/unless}}><span class="hkrpg-pip__shape"></span></button>
              {{/each}}
              {{#if resourcePips.soul.baseOverflow}}<span class="hkrpg-pip-overflow">+{{resourcePips.soul.baseOverflow}}</span>{{/if}}
            </div>
            <div class="hkrpg-resource-pips__temporary">
              {{#each resourcePips.soul.temporary as |pip|}}
                <button type="button" class="hkrpg-pip hkrpg-pip--soul hkrpg-pip--temporary" data-resource-pip="soulTemp" data-resource-target="{{pip.clickValue}}" title="{{localize "HKRPG.Tracker.SpendTemporary"}}" aria-label="{{localize "HKRPG.Tracker.SpendTemporary"}}" {{#unless isEditable}}disabled{{/unless}}><span class="hkrpg-pip__shape"></span></button>
              {{/each}}
              {{#if resourcePips.soul.temporaryOverflow}}<span class="hkrpg-pip-overflow hkrpg-pip-overflow--temporary">+{{resourcePips.soul.temporaryOverflow}}</span>{{/if}}
            </div>
          </div>
          <div class="hkrpg-header-resource__fields">
            <label><span>{{localize "HKRPG.Tracker.Current"}}</span><input data-resource-field="soul" type="number" min="0" max="999" value="{{system.resources.soul}}" {{#unless isEditable}}disabled{{/unless}} /></label>
            <label><span>{{localize "HKRPG.Tracker.Maximum"}}</span><input data-resource-field="soulMax" type="number" min="0" value="{{system.resources.soulMax}}" {{#unless isEditable}}disabled{{/unless}} /></label>
            <label><span>{{localize "HKRPG.Tracker.Temporary"}}</span><input data-resource-field="soulTemp" type="number" min="0" value="{{system.resources.soulTemp}}" {{#unless isEditable}}disabled{{/unless}} /></label>
          </div>
        </div>

        <div class="hkrpg-header-resource hkrpg-header-resource--stamina">
          <svg class="hkrpg-header-resource__icon hkrpg-header-resource__icon--stamina" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 1 15.2 8.8 23 12l-7.8 3.2L12 23l-3.2-7.8L1 12l7.8-3.2L12 1Z"/></svg>
          <span class="hkrpg-header-resource__name">{{localize "HKRPG.Resource.Stamina"}}</span>
          <strong class="hkrpg-header-resource__value">{{system.resources.stamina}} / {{system.resources.staminaMax}}</strong>
          <div class="hkrpg-resource-pips">
            <div class="hkrpg-resource-pips__base">
              {{#each resourcePips.stamina.base as |pip|}}
                <button type="button" class="hkrpg-pip hkrpg-pip--stamina {{#if pip.filled}}is-filled{{else}}is-empty{{/if}}" data-resource-pip="stamina" data-resource-target="{{pip.clickValue}}" title="{{pip.value}}" aria-label="{{localize "HKRPG.Resource.Stamina"}} {{pip.value}}" {{#unless isEditable}}disabled{{/unless}}><span class="hkrpg-pip__shape"></span></button>
              {{/each}}
              {{#if resourcePips.stamina.baseOverflow}}<span class="hkrpg-pip-overflow">+{{resourcePips.stamina.baseOverflow}}</span>{{/if}}
            </div>
            <div class="hkrpg-resource-pips__temporary">
              {{#each resourcePips.stamina.temporary as |pip|}}
                <button type="button" class="hkrpg-pip hkrpg-pip--stamina hkrpg-pip--temporary" data-resource-pip="staminaTemp" data-resource-target="{{pip.clickValue}}" title="{{localize "HKRPG.Tracker.SpendTemporary"}}" aria-label="{{localize "HKRPG.Tracker.SpendTemporary"}}" {{#unless isEditable}}disabled{{/unless}}><span class="hkrpg-pip__shape"></span></button>
              {{/each}}
              {{#if resourcePips.stamina.temporaryOverflow}}<span class="hkrpg-pip-overflow hkrpg-pip-overflow--temporary">+{{resourcePips.stamina.temporaryOverflow}}</span>{{/if}}
            </div>
          </div>
          <div class="hkrpg-header-resource__fields">
            <label><span>{{localize "HKRPG.Tracker.Current"}}</span><input data-resource-field="stamina" type="number" min="0" max="999" value="{{system.resources.stamina}}" {{#unless isEditable}}disabled{{/unless}} /></label>
            <label><span>{{localize "HKRPG.Tracker.Maximum"}}</span><input data-resource-field="staminaMax" type="number" min="0" value="{{system.resources.staminaMax}}" {{#unless isEditable}}disabled{{/unless}} /></label>
            <label><span>{{localize "HKRPG.Tracker.Temporary"}}</span><input data-resource-field="staminaTemp" type="number" min="0" value="{{system.resources.staminaTemp}}" {{#unless isEditable}}disabled{{/unless}} /></label>
          </div>
        </div>
      </div>
    </div>

    <section class="hkrpg-satiety-summary">
      <h2>{{localize "HKRPG.Resource.Satiety"}}</h2>
      <div class="hkrpg-satiety-values">
        <label>
          <span>{{localize "HKRPG.Tracker.Current"}}</span>
          <input name="system.resources.satiety" type="number" min="0" value="{{system.resources.satiety}}" />
        </label>
        <div class="hkrpg-satiety-maximum">
          <span>{{localize "HKRPG.Tracker.Maximum"}}</span>
          <div class="hkrpg-satiety-maximum__control">
            <input data-derived-input="satietyMax" type="number" min="0" max="999" step="1" value="{{system.derived.satietyMax}}" {{#unless isEditable}}disabled{{/unless}} />
            <button type="button" class="hkrpg-derived-stat__reset" data-reset-derived="satietyMax" title="{{localize "HKRPG.Derived.ResetAutomatic"}}" aria-label="{{localize "HKRPG.Derived.ResetAutomatic"}}" {{#unless isEditable}}disabled{{/unless}}>↺</button>
          </div>
        </div>
      </div>
      <label class="hkrpg-hunger-field">
        <span>{{localize "HKRPG.Resource.Hunger"}}</span>
        <input name="system.resources.hunger" type="number" min="0" value="{{system.resources.hunger}}" />
      </label>

      <section class="hkrpg-movement-summary">
        <h2>{{localize "HKRPG.Movement"}}</h2>
        <div class="hkrpg-movement-summary__values">
          <label>
            <span>{{localize "HKRPG.Secondary.Speed"}}</span>
            <input name="system.social.speed" type="number" min="0" value="{{system.social.speed}}" {{#unless isEditable}}disabled{{/unless}} />
          </label>
          <label>
            <span>{{localize "HKRPG.Derived.Maneuverability"}}</span>
            <div class="hkrpg-movement-summary__maneuverability">
              <input class="hkrpg-derived-stat__input" data-derived-input="maneuverability" type="number" min="0" max="999" step="1" value="{{system.derived.maneuverability}}" {{#unless isEditable}}disabled{{/unless}} />
              <button type="button" class="hkrpg-derived-stat__reset" data-reset-derived="maneuverability" title="{{localize "HKRPG.Derived.ResetAutomatic"}}" aria-label="{{localize "HKRPG.Derived.ResetAutomatic"}}" {{#unless isEditable}}disabled{{/unless}}>↺</button>
            </div>
          </label>
        </div>
      </section>
    </section>
  </header>

  <nav class="hkrpg-tabs" data-group="primary" aria-label="Разделы персонажа">
    <a class="item" data-tab="overview" data-group="primary">{{localize "HKRPG.Tabs.Overview"}}</a>
    <a class="item" data-tab="features" data-group="primary">{{localize "HKRPG.Tabs.Features"}}</a>
    <a class="item" data-tab="charms" data-group="primary">{{localize "HKRPG.Tabs.Charms"}}</a>
    <a class="item" data-tab="equipment" data-group="primary">{{localize "HKRPG.Tabs.Equipment"}}</a>
    <a class="item" data-tab="effects" data-group="primary">{{localize "HKRPG.Tabs.Effects"}}</a>
    <a class="item" data-tab="journal" data-group="primary">{{localize "HKRPG.Tabs.Journal"}}</a>
  </nav>

  <div class="hkrpg-tab-content">
    <section class="tab" data-group="primary" data-tab="overview">
      <div class="hkrpg-overview-grid">
        <div class="hkrpg-overview-main">
          <section class="hkrpg-overview-section">
            <h2>{{localize "HKRPG.Attributes"}}</h2>
            <div class="hkrpg-attributes-grid">
              <div class="hkrpg-attribute">
                <label class="hkrpg-attribute-score">
                  <span>{{localize "HKRPG.Attribute.Might"}}</span>
                  <input name="system.attributes.might" type="number" min="0" max="7" step="0.5" value="{{system.attributes.might}}" />
                </label>
                <label class="hkrpg-attribute-temporary">
                  <span>{{localize "HKRPG.Tracker.Temporary"}}</span>
                  <input name="system.attributeTemps.might" type="number" min="0" step="1" value="{{system.attributeTemps.might}}" />
                </label>
                <button type="button" data-attribute-roll="might" class="hkrpg-attribute-roll" title="{{localize "HKRPG.Roll.ClickToRoll"}}" aria-label="{{localize "HKRPG.Roll.ClickToRoll"}}">🎲</button>
              </div>

              <div class="hkrpg-attribute">
                <label class="hkrpg-attribute-score">
                  <span>{{localize "HKRPG.Attribute.Insight"}}</span>
                  <input name="system.attributes.insight" type="number" min="0" max="7" step="0.5" value="{{system.attributes.insight}}" />
                </label>
                <label class="hkrpg-attribute-temporary">
                  <span>{{localize "HKRPG.Tracker.Temporary"}}</span>
                  <input name="system.attributeTemps.insight" type="number" min="0" step="1" value="{{system.attributeTemps.insight}}" />
                </label>
                <button type="button" data-attribute-roll="insight" class="hkrpg-attribute-roll" title="{{localize "HKRPG.Roll.ClickToRoll"}}" aria-label="{{localize "HKRPG.Roll.ClickToRoll"}}">🎲</button>
              </div>

              <div class="hkrpg-attribute">
                <label class="hkrpg-attribute-score">
                  <span>{{localize "HKRPG.Attribute.Shell"}}</span>
                  <input name="system.attributes.shell" type="number" min="0" max="7" step="0.5" value="{{system.attributes.shell}}" />
                </label>
                <label class="hkrpg-attribute-temporary">
                  <span>{{localize "HKRPG.Tracker.Temporary"}}</span>
                  <input name="system.attributeTemps.shell" type="number" min="0" step="1" value="{{system.attributeTemps.shell}}" />
                </label>
                <button type="button" data-attribute-roll="shell" class="hkrpg-attribute-roll" title="{{localize "HKRPG.Roll.ClickToRoll"}}" aria-label="{{localize "HKRPG.Roll.ClickToRoll"}}">🎲</button>
              </div>

              <div class="hkrpg-attribute">
                <label class="hkrpg-attribute-score">
                  <span>{{localize "HKRPG.Attribute.Grace"}}</span>
                  <input name="system.attributes.grace" type="number" min="0" max="7" step="0.5" value="{{system.attributes.grace}}" />
                </label>
                <label class="hkrpg-attribute-temporary">
                  <span>{{localize "HKRPG.Tracker.Temporary"}}</span>
                  <input name="system.attributeTemps.grace" type="number" min="0" step="1" value="{{system.attributeTemps.grace}}" />
                </label>
                <button type="button" data-attribute-roll="grace" class="hkrpg-attribute-roll" title="{{localize "HKRPG.Roll.ClickToRoll"}}" aria-label="{{localize "HKRPG.Roll.ClickToRoll"}}">🎲</button>
              </div>
            </div>
          </section>

          <section class="hkrpg-overview-section">
            <h2>{{localize "HKRPG.OtherAttributes"}}</h2>
            <div class="hkrpg-secondary-grid">
              <div class="hkrpg-secondary-stat hkrpg-secondary-stat--rollable">
                <label>
                  <span>{{localize "HKRPG.Secondary.Spook"}}</span>
                  <input name="system.social.spook" type="number" min="0" step="0.5" value="{{system.social.spook}}" />
                </label>
                <button type="button" data-attribute-roll="spook" class="hkrpg-attribute-roll" title="{{localize "HKRPG.Roll.ClickToRoll"}}" aria-label="{{localize "HKRPG.Roll.ClickToRoll"}}">🎲</button>
              </div>
              <div class="hkrpg-secondary-stat hkrpg-secondary-stat--rollable">
                <label>
                  <span>{{localize "HKRPG.Secondary.Cute"}}</span>
                  <input name="system.social.cute" type="number" min="0" step="0.5" value="{{system.social.cute}}" />
                </label>
                <button type="button" data-attribute-roll="cute" class="hkrpg-attribute-roll" title="{{localize "HKRPG.Roll.ClickToRoll"}}" aria-label="{{localize "HKRPG.Roll.ClickToRoll"}}">🎲</button>
              </div>
            </div>
          </section>

          <section class="hkrpg-overview-section hkrpg-custom-reserves-section">
            <h2>{{localize "HKRPG.CustomReserves"}}</h2>
            <div class="hkrpg-custom-reserves">
              {{#each system.customReserves as |reserve key|}}
                <div class="hkrpg-custom-reserve">
                  <label class="hkrpg-custom-reserve__name">
                    <input name="system.customReserves.{{key}}.label" type="text" value="{{reserve.label}}" placeholder="{{localize "HKRPG.CustomReserve"}}" aria-label="{{localize "HKRPG.CustomReserve"}}" />
                  </label>
                  <div class="hkrpg-custom-reserve__fields">
                    <label>
                      <span>{{localize "HKRPG.Tracker.Maximum"}}</span>
                      <input name="system.customReserves.{{key}}.max" type="number" min="0" value="{{reserve.max}}" />
                    </label>
                    <label class="hkrpg-custom-reserve__current">
                      <span>{{localize "HKRPG.Tracker.Current"}}</span>
                      <input name="system.customReserves.{{key}}.current" type="number" min="0" value="{{reserve.current}}" />
                    </label>
                    <label>
                      <span>{{localize "HKRPG.Tracker.Temporary"}}</span>
                      <input name="system.customReserves.{{key}}.temporary" type="number" min="0" value="{{reserve.temporary}}" />
                    </label>
                  </div>
                </div>
              {{/each}}
            </div>
          </section>
        </div>

        <aside class="hkrpg-overview-side">
          <section class="hkrpg-overview-section hkrpg-skills-column">
            <h2>{{localize "HKRPG.Development.Proficiencies"}}</h2>
            <div class="hkrpg-skill-groups">
              {{#each skillGroups as |group|}}
                <section class="hkrpg-skill-group">
                  <div class="hkrpg-skill-group__header">
                    <input class="hkrpg-skill-group__name" name="system.skillGroups.{{group.id}}.name" type="text" value="{{group.name}}" placeholder="{{localize "HKRPG.Features.SkillGroupNamePlaceholder"}}" aria-label="{{localize "HKRPG.Features.SkillGroupNamePlaceholder"}} {{group.id}}" {{#unless ../isEditable}}disabled{{/unless}} />
                    <label class="hkrpg-skill-group__rank">
                      <span>{{localize "HKRPG.Features.Rank"}}</span>
                      <input name="system.skillGroups.{{group.id}}.rank" type="number" min="0" max="3" step="1" value="{{group.rank}}" {{#unless ../isEditable}}disabled{{/unless}} />
                    </label>
                  </div>

                  <div class="hkrpg-skill-group__mastery-heading">
                    <span>{{localize "HKRPG.Features.MasteryAtRank3"}}</span>
                  </div>

                  <div class="hkrpg-skill-group__rows">
                    {{#each group.skills as |skill|}}
                      <div class="hkrpg-skill-entry">
                        <input class="hkrpg-skill-entry__name" name="system.skillGroups.{{../id}}.skills.{{skill.id}}.name" type="text" value="{{skill.name}}" placeholder="{{localize "HKRPG.Features.SkillNamePlaceholder"}}" aria-label="{{localize "HKRPG.Features.SkillNamePlaceholder"}} {{skill.id}}" {{#unless ../../isEditable}}disabled{{/unless}} />
                        <input class="hkrpg-skill-entry__mastery" type="checkbox" data-skill-mastery="{{../id}}.{{skill.id}}" {{#if skill.isMastered}}checked{{/if}} aria-label="{{localize "HKRPG.Features.Mastery"}}: {{skill.name}}" title="{{localize "HKRPG.Features.Mastery"}}" {{#unless ../../isEditable}}disabled{{/unless}} {{#unless ../canMaster}}disabled{{/unless}} />
                      </div>
                    {{/each}}
                  </div>
                </section>
              {{/each}}
            </div>
          </section>
        </aside>
      </div>



    </section>

            <section class="tab hkrpg-features-tab" data-group="primary" data-tab="features">
      <div class="hkrpg-features-layout">
        <div class="hkrpg-features-column hkrpg-features-column--left">
          <section class="hkrpg-panel hkrpg-feature-panel hkrpg-traits-panel">
            <div class="hkrpg-panel-heading">
              <div>
                <h2>{{localize "HKRPG.Development.Traits"}}</h2>
                <p>{{localize "HKRPG.Features.TraitLimitNote"}}</p>
              </div>
              <strong class="hkrpg-feature-counter {{#if (gt traitCount 7)}}is-over-limit{{/if}}">{{traitCount}} / 7</strong>
            </div>

            {{#if legacyTraits.length}}
              <div class="hkrpg-feature-legacy-warning">
                <strong>{{localize "HKRPG.Features.LegacyEntries"}}</strong>
                <span>{{localize "HKRPG.Features.LegacyTraitHint"}}</span>
              </div>
            {{/if}}

            {{#if traitSlots.length}}
              <div class="hkrpg-trait-slots-grid">
                {{#each traitSlots as |slot|}}
                  <article class="hkrpg-trait-slot-card {{#if slot.trait}}is-filled{{else if slot.legacy}}is-legacy{{else}}is-empty{{/if}}"
                           data-trait-dropzone="{{slot.number}}"
                           aria-label="{{localize "HKRPG.Development.Traits"}} {{slot.number}}">
                    {{#if slot.trait}}
                      <img class="hkrpg-trait-slot-card__image" src="{{slot.trait.img}}" alt=""
                           draggable="true" data-trait-item-id="{{slot.trait.id}}" title="{{slot.trait.name}}" />
                      <strong class="hkrpg-trait-slot-card__name">{{slot.trait.name}}</strong>
                      <span class="hkrpg-trait-slot-card__category">{{slot.trait.categoryLabel}}</span>
                      <div class="hkrpg-trait-slot-card__controls">
                        <button type="button" data-edit-feature-item="{{slot.trait.id}}" title="{{localize "HKRPG.Features.EditEntry"}}">✎</button>
                        <button type="button" data-delete-feature-item="{{slot.trait.id}}" title="{{localize "HKRPG.Features.DeleteEntry"}}">×</button>
                      </div>
                    {{else if slot.legacy}}
                      <span class="hkrpg-trait-slot-card__empty-tile"></span>
                      <strong class="hkrpg-trait-slot-card__name">{{slot.legacy.name}}</strong>
                      <small>{{localize "HKRPG.Features.LegacyEntries"}}</small>
                    {{else}}
                      <span class="hkrpg-trait-slot-card__empty-tile"></span>
                      <span class="hkrpg-trait-slot-card__hint">{{localize "HKRPG.Features.DropTrait"}}</span>
                    {{/if}}
                  </article>
                {{/each}}
              </div>
            {{else}}
              <p class="hkrpg-empty">{{localize "HKRPG.Empty.NoTraits"}}</p>
            {{/if}}

            <footer class="hkrpg-feature-panel__footer">
              <div class="hkrpg-trait-totals">
                <span>Голод <strong>{{traitTotals.hungerLabel}}</strong></span>
                <span>Прив. <strong>{{traitTotals.cuteLabel}}</strong></span>
                <span>Жуть <strong>{{traitTotals.spookLabel}}</strong></span>
              </div>
            </footer>
          </section>

          {{#if legacyTraits.length}}
            <section class="hkrpg-feature-legacy-list hkrpg-panel">
              <p>{{localize "HKRPG.Features.LegacyTraitList"}}</p>
              <ul>
                {{#each legacyTraits as |trait|}}<li>{{trait.name}}</li>{{/each}}
              </ul>
            </section>
          {{/if}}

          <details class="hkrpg-panel hkrpg-spell-reference">
            <summary>{{localize "HKRPG.Features.SpellModifications"}}</summary>
            <p>{{localize "HKRPG.Features.SpellRangeSummary"}}</p>
            <p>{{localize "HKRPG.Features.SpellDurationSummary"}}</p>
            <p>{{localize "HKRPG.Features.SpellDamageSummary"}}</p>
            <ul>
              <li>{{localize "HKRPG.Features.SpellSplitSummary"}}</li>
              <li>{{localize "HKRPG.Features.SpellExpandSummary"}}</li>
              <li>{{localize "HKRPG.Features.SpellAccelerateSummary"}}</li>
              <li>{{localize "HKRPG.Features.SpellConjureSummary"}}</li>
            </ul>
            <small>{{localize "HKRPG.Features.SpellReferenceSource"}}</small>
          </details>
        </div>

        <div class="hkrpg-features-column hkrpg-features-column--right">
          <section class="hkrpg-panel hkrpg-feature-panel hkrpg-paths-panel">
            <div class="hkrpg-panel-heading">
              <div>
                <h2>{{localize "HKRPG.Development.Paths"}}</h2>
                <p>{{localize "HKRPG.Features.PathLimitNote"}}</p>
              </div>
              <strong>{{pathSummary.totalRanks}} {{localize "HKRPG.Features.TotalRanks"}}</strong>
            </div>

            {{#if pathSummary.unassignedCount}}
              <div class="hkrpg-feature-legacy-warning hkrpg-feature-unassigned-warning">
                <strong>{{localize "HKRPG.Features.UnassignedPathsTitle"}}</strong>
                <span>{{localize "HKRPG.Features.UnassignedPathsHint"}}</span>
              </div>
            {{/if}}

            {{#if legacyPaths.length}}
              <div class="hkrpg-feature-legacy-warning">
                <strong>{{localize "HKRPG.Features.LegacyEntries"}}</strong>
                <span>{{localize "HKRPG.Features.LegacyPathHint"}}</span>
              </div>
            {{/if}}

            {{#if pathSummary.paths.length}}
              <div class="hkrpg-path-list">
                {{#each pathSummary.paths as |path|}}
                  <article class="hkrpg-path-card">
                    <img class="hkrpg-path-card__image" src="{{path.img}}" alt="" title="{{path.name}}" />
                    <div class="hkrpg-path-card__identity">
                      <strong>{{path.name}}</strong>
                      <span class="hkrpg-path-type hkrpg-path-type--{{path.kind}}">{{path.kindLabel}}</span>
                    </div>
                    <label class="hkrpg-path-card__rank">
                      <span>{{localize "HKRPG.Features.Rank"}}</span>
                      <input type="number" min="1" max="3" step="1" value="{{path.rank}}" data-path-rank="{{path.id}}" {{#unless ../isEditable}}disabled{{/unless}} />
                    </label>
                    <div class="hkrpg-feature-actions">
                      <button type="button" data-edit-feature-item="{{path.id}}" title="{{localize "HKRPG.Features.EditEntry"}}">✎</button>
                      <button type="button" data-delete-feature-item="{{path.id}}" title="{{localize "HKRPG.Features.DeleteEntry"}}">×</button>
                    </div>
                  </article>
                {{/each}}
              </div>
            {{else}}
              <p class="hkrpg-empty">{{localize "HKRPG.Empty.NoPaths"}}</p>
            {{/if}}

            <div class="hkrpg-path-bonuses">
              <span>⊚ <strong>+{{pathSummary.totalRanks}}</strong> {{localize "HKRPG.Features.NotchesFromPaths"}}</span>
              <span><strong>+{{pathSummary.mysticRanks}}</strong> {{localize "HKRPG.Features.SoulFromMysticPaths"}}</span>
              <span><strong>+{{pathSummary.martialRanks}}</strong> {{localize "HKRPG.Features.StaminaFromMartialPaths"}}</span>
            </div>

            {{#if legacyPaths.length}}
              <button type="button" class="hkrpg-feature-add hkrpg-feature-add--secondary" data-migrate-legacy-features {{#unless isEditable}}disabled{{/unless}}>{{localize "HKRPG.Features.MigrateLegacy"}}</button>
            {{/if}}
            <button type="button" class="hkrpg-feature-add" data-create-path {{#unless isEditable}}disabled{{/unless}}>＋ {{localize "HKRPG.Features.AddPath"}}</button>
          </section>

          <section class="hkrpg-panel hkrpg-feature-panel hkrpg-techniques-panel">
            <div class="hkrpg-panel-heading">
              <div>
                <h2>{{localize "HKRPG.Development.Techniques"}}</h2>
                <p>{{localize "HKRPG.Features.PreparedArtsArcana"}}</p>
              </div>
              <div class="hkrpg-technique-slots-meta">
                <strong>{{preparedTechniqueCount}} / {{system.derived.techniqueSlots}}</strong>
                <label class="hkrpg-technique-slot-bonus">
                  <span>{{localize "HKRPG.Features.ExtraTechniqueSlots"}}</span>
                  <input name="system.resources.techniqueSlotsBonus" type="number" min="0" max="99" value="{{techniqueSlotBonus}}" {{#unless isEditable}}disabled{{/unless}} />
                </label>
              </div>
            </div>
            {{#if techniqueSlots.length}}
              <div class="hkrpg-technique-slots-grid">
                {{#each techniqueSlots as |slot|}}
                  <div class="hkrpg-technique-slot-card {{#if slot.item}}is-filled{{else if slot.legacy}}is-legacy{{else}}is-empty{{/if}}"
                       data-technique-dropzone="{{slot.number}}"
                       aria-label="{{localize "HKRPG.Features.TechniqueSlot"}} {{slot.number}}">
                    {{#if slot.item}}
                      <img class="hkrpg-technique-slot-card__image"
                           src="{{slot.item.img}}"
                           alt="{{slot.item.name}}"
                           title="{{slot.item.name}}"
                           draggable="true"
                           data-technique-item-id="{{slot.item.id}}" />
                      <span class="hkrpg-technique-slot-card__name">{{slot.item.name}}</span>
                      <button type="button" class="hkrpg-technique-slot-card__remove"
                              data-unprepare-technique="{{slot.item.id}}"
                              title="{{localize "HKRPG.Features.UnprepareTechnique"}}"
                              aria-label="{{localize "HKRPG.Features.UnprepareTechnique"}}"
                              {{#unless ../isEditable}}disabled{{/unless}}>×</button>
                    {{else if slot.legacy}}
                      <span class="hkrpg-technique-slot-card__legacy">{{slot.legacy.name}}</span>
                      <small>{{localize "HKRPG.Features.LegacyTechnique"}}</small>
                    {{else}}
                      <span class="hkrpg-technique-slot-card__plus" aria-hidden="true">＋</span>
                      <span class="hkrpg-technique-slot-card__hint">{{localize "HKRPG.Features.DropTechnique"}}</span>
                    {{/if}}
                  </div>
                {{/each}}
              </div>
              {{#if unpreparedTechniques.length}}
                <div class="hkrpg-technique-collection">
                  <span class="hkrpg-technique-collection__title">{{localize "HKRPG.Features.UnpreparedTechniques"}}</span>
                  <div class="hkrpg-technique-collection__items">
                    {{#each unpreparedTechniques as |item|}}
                      <article class="hkrpg-technique-collection__item"
                               draggable="true"
                               data-technique-item-id="{{item.id}}"
                               title="{{item.name}}">
                        <img src="{{item.img}}" alt="" />
                        <span>{{item.name}}</span>
                      </article>
                    {{/each}}
                  </div>
                </div>
              {{/if}}
            {{else}}
              <p class="hkrpg-empty">{{localize "HKRPG.Features.NoTechniqueSlots"}}</p>
            {{/if}}
          </section>
        </div>
      </div>
    </section>

    <section class="tab hkrpg-charms-tab" data-group="primary" data-tab="charms">
      <div class="hkrpg-charms-page">
        <section class="hkrpg-charms-equipped-panel">
          <header class="hkrpg-charms-section-heading">
            <h2>{{localize "HKRPG.Charms.Equipped"}}</h2>
            <span>{{itemGroups.equippedCharms.length}} {{localize "HKRPG.Charms.EquippedCount"}}</span>
          </header>
          <div class="hkrpg-charms-equipped-dropzone hkrpg-charm-dropzone" data-charm-dropzone="equipped">
            {{#if itemGroups.equippedCharms.length}}
              {{#each itemGroups.equippedCharms as |charm|}}
                <article class="hkrpg-charm-token hkrpg-charm-draggable" data-charm-item-id="{{charm.id}}" draggable="true" title="{{charm.name}} · ⊚ {{charm.system.notches}}">
                  <img src="{{charm.img}}" alt="{{charm.name}}" />
                  <span class="hkrpg-charm-token__cost">{{charm.system.notches}}</span>
                  <button type="button" class="hkrpg-charm-token__remove" data-unequip-charm="{{charm.id}}" title="{{localize "HKRPG.Charms.Unequip"}}" aria-label="{{localize "HKRPG.Charms.Unequip"}}" {{#unless ../isEditable}}disabled{{/unless}}>×</button>
                </article>
              {{/each}}
            {{else}}
              <p class="hkrpg-charms-drop-hint">{{localize "HKRPG.Charms.DropToEquip"}}</p>
            {{/if}}
          </div>
        </section>

        <section class="hkrpg-notches-panel">
          <header class="hkrpg-charms-section-heading hkrpg-notches-heading">
            <div>
              <h2>{{localize "HKRPG.Charms.Notches"}} <span>⊚</span></h2>
              <p>{{localize "HKRPG.Charms.NotchesFormula"}}</p>
            </div>
            <div class="hkrpg-notches-summary">
              <strong>{{charmNotches.used}} / {{charmNotches.maximum}}</strong>
              <label>
                <span>{{localize "HKRPG.Charms.BonusNotches"}}</span>
                <input data-resource-field="notchesBonus" type="number" min="0" max="99" step="1" value="{{notchBonus}}" {{#unless isEditable}}disabled{{/unless}} />
              </label>
            </div>
          </header>
          <div class="hkrpg-notch-track" aria-label="{{localize "HKRPG.Charms.Notches"}}">
            {{#each charmNotches.slots as |notch|}}
              <span class="hkrpg-notch {{#if notch.filled}}is-filled{{/if}}" title="{{notch.value}}"></span>
            {{/each}}
            {{#if charmNotches.overflow}}<span class="hkrpg-notch-overflow">+{{charmNotches.overflow}}</span>{{/if}}
          </div>
          {{#if charmNotches.overcharmed}}
            <div class="hkrpg-overcharmed-warning">
              <strong>{{localize "HKRPG.Charms.Overcharmed"}}</strong>
              <span>{{localize "HKRPG.Charms.OvercharmedDescription"}}</span>
            </div>
          {{/if}}
          <p class="hkrpg-charms-rule-note">{{localize "HKRPG.Charms.RestRule"}}</p>
        </section>

        <section class="hkrpg-charms-collection-panel">
          <header class="hkrpg-charms-section-heading">
            <div>
              <h2>{{localize "HKRPG.Charms.Collection"}}</h2>
              <p>{{localize "HKRPG.Charms.CollectionHint"}}</p>
            </div>
            <button type="button" class="hkrpg-charm-create" data-create-charm {{#unless isEditable}}disabled{{/unless}}>
              <span>＋</span> {{localize "HKRPG.Charms.Create"}}
            </button>
          </header>
          <div class="hkrpg-charms-collection-dropzone hkrpg-charm-dropzone" data-charm-dropzone="collection">
            {{#if itemGroups.collectionCharms.length}}
              <div class="hkrpg-charms-collection-grid">
                {{#each itemGroups.collectionCharms as |charm|}}
                  <article class="hkrpg-charm-card hkrpg-charm-draggable" data-charm-item-id="{{charm.id}}" draggable="true">
                    <button type="button" class="hkrpg-charm-card__edit" data-edit-charm="{{charm.id}}" title="{{localize "HKRPG.Charms.Edit"}}" aria-label="{{localize "HKRPG.Charms.Edit"}}">
                      <img src="{{charm.img}}" alt="{{charm.name}}" />
                    </button>
                    <div class="hkrpg-charm-card__details">
                      <strong title="{{charm.name}}">{{charm.name}}</strong>
                      <span>⊚ {{charm.system.notches}}</span>
                    </div>
                  </article>
                {{/each}}
              </div>
            {{else}}
              <p class="hkrpg-charms-drop-hint">{{localize "HKRPG.Charms.DropToCollection"}}</p>
            {{/if}}
          </div>
        </section>
      </div>
    </section>

<section class="tab hkrpg-equipment-tab" data-group="primary" data-tab="equipment">
      <div class="hkrpg-equipment-layout">
        <section class="hkrpg-panel hkrpg-equipment-panel hkrpg-equipment-panel--inventory" data-equipment-dropzone="equipment">
          <header class="hkrpg-equipment-heading">
            <div>
              <h2>{{localize "HKRPG.Equipment.Inventory"}}</h2>
              <span class="hkrpg-equipment-count">{{itemGroups.equipment.length}}</span>
            </div>
            <div class="hkrpg-equipment-heading__actions">
              <span class="hkrpg-equipment-column-title">{{localize "HKRPG.Equipment.Weight"}}</span>
              <button type="button" class="hkrpg-equipment-add" data-create-equipment-row="equipment" {{#unless isEditable}}disabled{{/unless}}>＋ Строка</button>
            </div>
          </header>
          <div class="hkrpg-equipment-rows">
            {{#each equipmentRows as |row|}}
              <article class="hkrpg-equipment-row {{#if row.isEmpty}}is-empty{{/if}}" {{#if row.item}}data-equipment-item="{{row.item.id}}" data-equipment-item-id="{{row.item.id}}" draggable="true" title="{{row.name}}"{{/if}}>
                {{#if row.item}}
                  <input class="hkrpg-equipment-row__name" type="text" value="{{row.name}}" data-equipment-id="{{row.item.id}}" data-equipment-field="name" aria-label="Название предмета" {{#unless ../isEditable}}disabled{{/unless}} />
                  <input class="hkrpg-equipment-value" type="number" min="0" step="0.1" value="{{row.values.weight}}" data-equipment-id="{{row.item.id}}" data-equipment-field="weight" aria-label="Вес" {{#unless ../isEditable}}disabled{{/unless}} />
                  <button type="button" class="hkrpg-equipment-remove" data-delete-equipment-item="{{row.item.id}}" title="Удалить строку" {{#unless ../isEditable}}disabled{{/unless}}>×</button>
                {{else}}
                  <span class="hkrpg-equipment-row__name">&nbsp;</span><span class="hkrpg-equipment-value"></span><span></span>
                {{/if}}
              </article>
            {{/each}}
          </div>
          <p class="hkrpg-equipment-hint">{{localize "HKRPG.Equipment.DragHint"}}</p>
        </section>

        <section class="hkrpg-panel hkrpg-equipment-panel hkrpg-equipment-panel--combat">
          <section class="hkrpg-equipment-subsection hkrpg-equipment-subsection--weapons" data-equipment-dropzone="combat">
            <header class="hkrpg-equipment-heading">
              <div>
                <h2>{{localize "HKRPG.Equipment.WeaponsAndShields"}}</h2>
                <span class="hkrpg-equipment-count">{{itemGroups.weapons.length}} + {{itemGroups.shields.length}}</span>
              </div>
              <div class="hkrpg-equipment-heading__actions">
                <div class="hkrpg-equipment-column-head hkrpg-equipment-column-head--combat">
                  <span>{{localize "HKRPG.Equipment.Weight"}}</span>
                  <span>{{localize "HKRPG.Equipment.Damage"}}</span>
                  <span>{{localize "HKRPG.Equipment.Range"}}</span>
                  <span>{{localize "HKRPG.Equipment.Quantity"}}</span>
                </div>
                <button type="button" class="hkrpg-equipment-add" data-create-equipment-row="weapon" {{#unless isEditable}}disabled{{/unless}}>＋ Строка</button>
              </div>
            </header>
            <div class="hkrpg-equipment-rows">
              {{#each combatEquipmentRows as |row|}}
                <article class="hkrpg-equipment-row hkrpg-equipment-row--combat {{#if row.isEmpty}}is-empty{{/if}}" {{#if row.item}}data-equipment-item="{{row.item.id}}" data-equipment-item-id="{{row.item.id}}" draggable="true" title="{{row.name}}"{{/if}}>
                  {{#if row.item}}
                    <input class="hkrpg-equipment-row__name" type="text" value="{{row.name}}" data-equipment-id="{{row.item.id}}" data-equipment-field="name" aria-label="Название оружия" {{#unless ../isEditable}}disabled{{/unless}} />
                    <input class="hkrpg-equipment-value" type="number" min="0" step="0.1" value="{{row.values.weight}}" data-equipment-id="{{row.item.id}}" data-equipment-field="weight" aria-label="Вес" {{#unless ../isEditable}}disabled{{/unless}} />
                    <input class="hkrpg-equipment-value" type="text" value="{{row.values.damage}}" data-equipment-id="{{row.item.id}}" data-equipment-field="damage" aria-label="Урон" {{#unless ../isEditable}}disabled{{/unless}} />
                    <input class="hkrpg-equipment-value" type="text" value="{{row.values.range}}" data-equipment-id="{{row.item.id}}" data-equipment-field="range" aria-label="Дальность" {{#unless ../isEditable}}disabled{{/unless}} />
                    <input class="hkrpg-equipment-value" type="number" min="0" step="1" value="{{row.values.quantity}}" data-equipment-id="{{row.item.id}}" data-equipment-field="quantity" aria-label="Количество" {{#unless ../isEditable}}disabled{{/unless}} />
                    <button type="button" class="hkrpg-equipment-remove" data-delete-equipment-item="{{row.item.id}}" title="Удалить строку" {{#unless ../isEditable}}disabled{{/unless}}>×</button>
                  {{else}}
                    <span class="hkrpg-equipment-row__name">&nbsp;</span><span class="hkrpg-equipment-value"></span><span class="hkrpg-equipment-value"></span><span class="hkrpg-equipment-value"></span><span class="hkrpg-equipment-value"></span><span></span>
                  {{/if}}
                </article>
              {{/each}}
            </div>
          </section>

          <section class="hkrpg-equipment-subsection hkrpg-equipment-subsection--armor" data-equipment-dropzone="armor">
            <header class="hkrpg-equipment-heading">
              <div>
                <h2>{{localize "HKRPG.Equipment.Armor"}}</h2>
                <span class="hkrpg-equipment-count">{{itemGroups.armor.length}}</span>
              </div>
              <div class="hkrpg-equipment-heading__actions">
                <div class="hkrpg-equipment-column-head hkrpg-equipment-column-head--armor">
                  <span>{{localize "HKRPG.Equipment.Weight"}}</span>
                  <span>{{localize "HKRPG.Equipment.Protection"}}</span>
                  <span>{{localize "HKRPG.Equipment.Durability"}}</span>
                </div>
                <button type="button" class="hkrpg-equipment-add" data-create-equipment-row="armor" {{#unless isEditable}}disabled{{/unless}}>＋ Строка</button>
              </div>
            </header>
            <div class="hkrpg-equipment-rows">
              {{#each armorRows as |row|}}
                <article class="hkrpg-equipment-row hkrpg-equipment-row--armor {{#if row.isEmpty}}is-empty{{/if}}" {{#if row.item}}data-equipment-item="{{row.item.id}}" data-equipment-item-id="{{row.item.id}}" draggable="true" title="{{row.name}}"{{/if}}>
                  {{#if row.item}}
                    <input class="hkrpg-equipment-row__name" type="text" value="{{row.name}}" data-equipment-id="{{row.item.id}}" data-equipment-field="name" aria-label="Название брони" {{#unless ../isEditable}}disabled{{/unless}} />
                    <input class="hkrpg-equipment-value" type="number" min="0" step="0.1" value="{{row.values.weight}}" data-equipment-id="{{row.item.id}}" data-equipment-field="weight" aria-label="Вес" {{#unless ../isEditable}}disabled{{/unless}} />
                    <input class="hkrpg-equipment-value" type="text" value="{{row.values.protection}}" data-equipment-id="{{row.item.id}}" data-equipment-field="protection" aria-label="ПУ" {{#unless ../isEditable}}disabled{{/unless}} />
                    <input class="hkrpg-equipment-value" type="number" min="0" step="1" value="{{row.values.durability}}" data-equipment-id="{{row.item.id}}" data-equipment-field="durability" aria-label="Прочность" {{#unless ../isEditable}}disabled{{/unless}} />
                    <button type="button" class="hkrpg-equipment-remove" data-delete-equipment-item="{{row.item.id}}" title="Удалить строку" {{#unless ../isEditable}}disabled{{/unless}}>×</button>
                  {{else}}
                    <span class="hkrpg-equipment-row__name">&nbsp;</span><span class="hkrpg-equipment-value"></span><span class="hkrpg-equipment-value"></span><span class="hkrpg-equipment-value"></span><span></span>
                  {{/if}}
                </article>
              {{/each}}
            </div>
          </section>
        </section>
      </div>

      <section class="hkrpg-panel hkrpg-equipment-footer">
        <label class="hkrpg-equipment-currency">
          <span>{{localize "HKRPG.Equipment.Currency"}}</span>
          <input name="system.inventory.currency" type="number" min="0" value="{{system.inventory.currency}}" {{#unless isEditable}}disabled{{/unless}} />
        </label>
        <div class="hkrpg-equipment-total">
          <span>{{localize "HKRPG.Derived.CarryingCapacity"}}</span>
          <strong>{{system.derived.carryingCapacity}}</strong>
        </div>
        <div class="hkrpg-equipment-total">
          <span>{{localize "HKRPG.Derived.BeltSize"}}</span>
          <strong>{{system.derived.beltSize}}</strong>
        </div>
        <p class="hkrpg-empty">{{localize "HKRPG.Empty.WeightLater"}}</p>
      </section>
    </section>

    <section class="tab" data-group="primary" data-tab="effects">
      <div class="hkrpg-section-grid hkrpg-effects-grid">
        <section class="hkrpg-panel hkrpg-effects-panel">
          <div class="hkrpg-panel-heading"><h2>{{localize "HKRPG.Development.Marks"}}</h2></div>
          <p class="hkrpg-empty">{{localize "HKRPG.Empty.MarksLater"}}</p>
        </section>
      </div>
    </section>

<section class="tab" data-group="primary" data-tab="journal">
      <div class="hkrpg-notes-layout">
        <section class="hkrpg-panel">
          <h2>{{localize "HKRPG.Profile.Description"}}</h2>
          <textarea name="system.profile.description" rows="8">{{system.profile.description}}</textarea>
        </section>
        <section class="hkrpg-panel hkrpg-notes-panel">
          <h2>{{localize "HKRPG.Notes"}}</h2>
          <textarea name="system.notes" rows="16" placeholder="{{localize "HKRPG.NotesPlaceholder"}}">{{system.notes}}</textarea>
        </section>
      </div>
    </section>
  </div>
</form>