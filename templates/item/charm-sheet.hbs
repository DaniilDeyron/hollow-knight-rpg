<form class="{{cssClass}} hkrpg-charm-item-form" autocomplete="off">
  <header class="hkrpg-charm-item-header">
    <img class="hkrpg-charm-item-image" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <label class="hkrpg-charm-item-title">
      <span>{{localize "HKRPG.Profile.Name"}}</span>
      <input name="name" type="text" value="{{item.name}}" placeholder="{{localize "HKRPG.Charms.NamePlaceholder"}}" {{#unless isEditable}}disabled{{/unless}} />
    </label>
    <label class="hkrpg-charm-item-notch" title="{{localize "HKRPG.Charms.NotchCost"}}">
      <span aria-hidden="true">⊚</span>
      <input name="system.notches" type="number" min="1" max="99" step="1" value="{{system.notches}}" aria-label="{{localize "HKRPG.Charms.NotchCost"}}" {{#unless isEditable}}disabled{{/unless}} />
    </label>
  </header>

  <nav class="hkrpg-charm-tabs tabs" data-group="primary" aria-label="{{localize "HKRPG.Charms.ItemSections"}}">
    <a class="item" data-tab="description">{{localize "HKRPG.Charms.Description"}}</a>
    <a class="item" data-tab="effect">{{localize "HKRPG.Charms.Effect"}}</a>
  </nav>

  <div class="hkrpg-charm-tab-content">
    <section class="tab hkrpg-charm-tab-panel" data-group="primary" data-tab="description">
      <textarea class="hkrpg-charm-editor" name="system.description" rows="12" placeholder="{{localize "HKRPG.Charms.DescriptionPlaceholder"}}" aria-label="{{localize "HKRPG.Charms.Description"}}" {{#unless isEditable}}disabled{{/unless}}>{{system.description}}</textarea>
    </section>

    <section class="tab hkrpg-charm-tab-panel" data-group="primary" data-tab="effect">
      <textarea class="hkrpg-charm-editor" name="system.effects" rows="12" placeholder="{{localize "HKRPG.Charms.EffectPlaceholder"}}" aria-label="{{localize "HKRPG.Charms.Effect"}}" {{#unless isEditable}}disabled{{/unless}}>{{system.effects}}</textarea>
    </section>
  </div>
</form>
