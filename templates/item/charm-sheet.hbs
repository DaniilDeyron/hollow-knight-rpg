<form class="{{cssClass}} hkrpg-charm-item-form" autocomplete="off">
  <header class="hkrpg-charm-item-header">
    <img class="hkrpg-charm-item-image" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <label class="hkrpg-charm-item-title">
      <span>{{localize "HKRPG.Profile.Name"}}</span>
      <input name="name" type="text" value="{{item.name}}" placeholder="{{localize "HKRPG.Charms.NamePlaceholder"}}" {{#unless isEditable}}disabled{{/unless}} />
    </label>
    <label class="hkrpg-charm-item-notch" title="{{localize "HKRPG.Charms.NotchCost"}}">
      <span aria-hidden="true">⊚</span>
      <input name="system.notches" type="number" min="1" max="99" step="1" value="{{system.notches}}" aria-label="{{localize "HKRPG.Charms.NotchCost"}}" {{#unless isEditable}}disabled{{/unless}} />
    </label>
  </header>

  <nav class="hkrpg-charm-tabs tabs" data-group="primary">
    <a class="item" data-tab="description">{{localize "HKRPG.Charms.Description"}}</a>
    <a class="item" data-tab="effect">{{localize "HKRPG.Charms.Effect"}}</a>
  </nav>

  <div class="hkrpg-charm-tab-content">
    <section class="tab hkrpg-charm-item-section hkrpg-charm-item-description" data-group="primary" data-tab="description">
      <h2>{{localize "HKRPG.Charms.Description"}}</h2>
      <textarea name="system.description" rows="9" placeholder="{{localize "HKRPG.Charms.DescriptionPlaceholder"}}" {{#unless isEditable}}disabled{{/unless}}>{{system.description}}</textarea>
    </section>

    <section class="tab hkrpg-charm-item-section hkrpg-charm-item-effects" data-group="primary" data-tab="effect">
      <h2>{{localize "HKRPG.Charms.Effect"}}</h2>
      <textarea name="system.effects" rows="9" placeholder="{{localize "HKRPG.Charms.EffectPlaceholder"}}" {{#unless isEditable}}disabled{{/unless}}>{{system.effects}}</textarea>
    </section>
  </div>
</form>
